{
    "require": {
        "php": ">=8.2",
        "mustache/mustache": "^3.0",
        "monolog/monolog": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Webmin\\": "src/Webmin/",
            "MotoGp\\": "src/MotoGp/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "format": "php-cs-fixer fix",
        "format-check": "php-cs-fixer fix --dry-run --diff"
    }
}
