
{{< partials/layout}}
    {{$title}}{{ app.name }} • Results{{/title}}

    {{$content}}
        <h1>Results</h1>
        {{#event}}
            <p>{{> partials/race }}<small class="motogp-secondary"> | {{ event.display_date }}</small></p>
        {{/event}}
        <table>
            <thead>
                <tr>
                    <th>Position</th>
                    <th>Rider</th>
                </tr>
            </thead>

            <tbody>
                {{#results}}
                    <tr>
                        <td>
                            {{ position }}
                            {{ display_status }}
                        </td>
                        <td>{{> partials/rider }}</td>
                    </tr>
                {{/results}}
            </tbody>
        </table>

        <p><a href="https://www.motogp.com/en/world-standing/{{ app.season }}/motogp/championship-standings" target="_blank">Results and standings</a> for the MotoGP {{ app.season }} season from the <a href="https://www.motogp.com/en" target="_blank">official site.</a></p>
    {{/content}}
{{/partials/layout}}
