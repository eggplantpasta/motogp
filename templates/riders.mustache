{{< partials/layout}}

    {{$title}}{{ app.name }} • Riders{{/title}}

    {{$content}}

        <h1>Riders</h1>

        <table>
            <thead>
                <tr>
                    <th>Rider</th>
                    <th>Team</th>
                </tr>
            </thead>

            <tbody>
                {{#riders}}
                    <tr>
                        <td class="{{ cell-class }}">{{> partials/rider }}</td>
                        <td class="{{ cell-class }}">{{ team_name }}</td>
                    </tr>
                {{/riders}}
            </tbody>
        </table>

    {{/content}}

{{/partials/layout}}
