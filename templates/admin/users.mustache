{{< partials/layout}}

    {{$title}}{{ app.name }} • Manage Users{{/title}}

    {{$content}}

        <h1>Manage Users</h1>

        <p>Select a user to view or manage their account.</p>

        <figure>
            <table class="motogp-table">
                <thead>
                    <tr>
                        <th scope="col">Username</th>
                        <th scope="col">Email</th>
                        <th scope="col">Balance</th>
                        <th scope="col">Registered</th>
                        <th scope="col">Admin</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>

                <tbody>
                    {{#users}}
                        <tr>
                            <td>
                                <a href="/admin/user.php?user_id={{ user_id }}">
                                    {{ username }}
                                </a>
                            </td>
                            <td>{{ email }}</td>
                            <td>{{ balance }}</td>
                            <td>{{ created_at_display }}</td>
                            <td>
                                {{#admin}}
                                    <span class="motogp-icon" aria-label="Yes">
                                        {{> partials/icons/yes }}
                                    </span>
                                {{/admin}}
                            </td>
                            <td>
                                {{#pendingApproval}}
                                    <mark>Pending approval</mark>
                                {{/pendingApproval}}

                                {{#disabled}}
                                    <span class="motogp-icon" aria-label="Disabled">
                                        {{> partials/icons/lock }}
                                    </span>
                                {{/disabled}}
                            </td>
                        </tr>
                    {{/users}}

                    {{^users}}
                        <tr>
                            <td colspan="6">No users found.</td>
                        </tr>
                    {{/users}}
                </tbody>
            </table>
        </figure>
    {{/content}}
{{/partials/layout}}
