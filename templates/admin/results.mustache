{{< partials/layout}}

    {{$title}}{{ app.name }} • Manage Results{{/title}}

    {{$content}}

        <h1>Manage Results</h1>

        {{#events | count}}
            <form method="get" action="/admin/results.php">
                <label for="event-id-select">Race</label>
                <select
                    id="event-id-select"
                    name="event_id"
                    onchange="this.form.submit()"
                >
                    {{#events}}
                        <option value="{{ event_id }}" {{#selected}}selected{{/selected}}>
                            {{ name }}
                        </option>
                    {{/events}}
                </select>
            </form>
        {{/events}}

        {{^events | count}}
            <p>No races have been added.</p>
        {{/events}}

        {{#event}}

            <h2>{{> partials/race }}</h2>

            {{#form.message}}
                <p class="{{ form.message-class }}">{{ form.message }}</p>
            {{/form.message}}

            {{#results | count}}
                {{#settled}}
                    <p>Payouts have been settled. Results are now locked.</p>

                    <table class="motogp-table">
                        <thead>
                            <tr>
                                <th>Position</th>
                                <th>Status</th>
                                <th>Rider</th>
                            </tr>
                        </thead>

                        <tbody>
                            {{#results}}
                                <tr>
                                    <td>{{ position }}</td>
                                    <td>
                                        {{#status_dnf}}DNF{{/status_dnf}}
                                        {{#status_dns}}DNS{{/status_dns}}
                                        {{#status_dsq}}DSQ{{/status_dsq}}
                                    </td>
                                    <td>{{> partials/rider }}</td>
                                </tr>
                            {{/results}}
                        </tbody>
                    </table>
                {{/settled}}

                {{^settled}}
                    <form method="post" action="/admin/results.php">
                        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                        <input type="hidden" name="event-id" value="{{ event_id }}">

                        <button type="submit">save results</button>

                        <table class="motogp-table">
                            <thead>
                                <tr>
                                    <th>Position</th>
                                    <th>Status</th>
                                    <th>Rider</th>
                                </tr>
                            </thead>

                            <tbody>
                                {{#results}}
                                    <tr>
                                        <td>
                                            <input
                                                type="number"
                                                name="positions[{{ rider_id }}]"
                                                value="{{ position }}"
                                                min="1"
                                                step="1"
                                            >
                                        </td>

                                        <td>
                                            <select name="statuses[{{ rider_id }}]">
                                                <option value="" {{#status_finish}}selected{{/status_finish}}>
                                                    Finish
                                                </option>
                                                <option value="dnf" {{#status_dnf}}selected{{/status_dnf}}>
                                                    DNF
                                                </option>
                                                <option value="dns" {{#status_dns}}selected{{/status_dns}}>
                                                    DNS
                                                </option>
                                                <option value="dsq" {{#status_dsq}}selected{{/status_dsq}}>
                                                    DSQ
                                                </option>
                                            </select>
                                        </td>
                                        <td>{{> partials/rider }}</td>
                                    </tr>
                                {{/results}}
                            </tbody>
                        </table>

                        <button type="submit">save results</button>

                    </form>
                {{/settled}}
            {{/results}}
            {{^results | count}}
                <p>No riders are available for this race.</p>
            {{/results}}
        {{/event}}

    {{/content}}

{{/partials/layout}}
