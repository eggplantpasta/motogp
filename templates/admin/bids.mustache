{{< partials/layout}}

    {{$title}}{{ app.name }} • Bid Resolution{{/title}}

    {{$content}}

        <h1>Bid Resolution</h1>

        {{#events | count}}
            <form method="get" action="/admin/bids.php">
                <label for="event-id-select">Event</label>
                <select
                    id="event-id-select"
                    name="event_id"
                    onchange="this.form.submit()"
                >
                    {{#events}}
                        <option
                            value="{{ event_id }}"
                            {{#selected}}selected{{/selected}}
                        >
                            {{ name }}
                        </option>
                    {{/events}}
                </select>
            </form>
        {{/events}}

        {{^events | count}}
            <p>No events have been added.</p>
        {{/events}}

        {{#event}}

            <h2>{{ name }}</h2>

            <p>{{ display_date }} · {{ circuit }}</p>

            {{#event.bids_open}}
                <article>
                    Bidding is still open. These results are provisional.
                </article>
            {{/event.bids_open}}

            {{#resolved}}
                <article>
                    Bidding has been resolved.
                </article>
            {{/resolved}}

            {{#can_resolve}}
                <form method="post" action="/admin/bids.php?event_id={{ event.event_id }}">
                    <input
                        type="hidden"
                        name="csrf_token"
                        value="{{ csrfToken }}"
                    >
                    <input
                        type="hidden"
                        name="action"
                        value="resolve"
                    >

                    <button type="submit">
                        Resolve Bidding
                    </button>
                </form>
            {{/can_resolve}}

            {{#riders}}
                <article>
                    <header>
                        <strong>#{{ race_number }} {{ name }}</strong>
                    </header>

                    <table>
                        <thead>
                            <tr>
                                <th>Player</th>
                                <th>Bid</th>
                                <th>Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#bids}}
                                <tr>
                                    <td>{{ username }}</td>
                                    <td>{{ amount }}</td>
                                    <td>
                                        {{#winner}}
                                            <strong>Winner</strong>
                                        {{/winner}}
                                    </td>
                                </tr>
                            {{/bids}}
                        </tbody>
                    </table>
                </article>
            {{/riders}}

            {{^riders}}
                <p>No bids have been placed for this event.</p>
            {{/riders}}

            {{#payout}}

                <h2>Payout{{^settled}} Preview{{/settled}}</h2>

                <p>
                    Prize pool:
                    <strong>{{ pool }}</strong>
                    points from
                    <strong>{{ winning_bids }}</strong>
                    winning bids.
                </p>

                <table>
                    <thead>
                        <tr>
                            <th>Finish</th>
                            <th>Rider</th>
                            <th>Player</th>
                            <th>Share</th>
                            <th>Payout</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#payouts}}
                            <tr>
                                <td>{{ finish_position }}</td>
                                <td>#{{ race_number }} {{ name }}</td>
                                <td>{{ username }}</td>
                                <td>{{ percentage }}%</td>
                                <td><strong>{{ payout }}</strong></td>
                            </tr>
                        {{/payouts}}
                    </tbody>
                </table>

                {{^payouts}}
                    <p>No classified winning riders are eligible for a payout.</p>
                {{/payouts}}

                {{#resolved}}
                    {{^results_complete}}
                        <article>
                            Results must be entered for all winning riders before
                            payouts can be settled.
                        </article>
                    {{/results_complete}}
                {{/resolved}}

                {{#can_settle}}
                    <form
                        id="settle-payouts-form"
                        method="post"
                        action="/admin/bids.php?event_id={{ event.event_id }}"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            value="{{ csrfToken }}"
                        >
                        <input
                            type="hidden"
                            name="action"
                            value="settle"
                        >

                        <button
                            type="button"
                            data-action="settle-payouts"
                        >
                            Settle Payouts
                        </button>
                    </form>
                {{/can_settle}}

                {{#settled}}
                    <article>
                        Payouts have been settled.
                    </article>
                {{/settled}}

            {{/payout}}

        {{/event}}

        {{> partials/modal-confirm }}

    {{/content}}

    {{$scripts}}
        <script src="/assets/js/bids.js"></script>
    {{/scripts}}

{{/partials/layout}}
