{{< partials/layout}}

    {{$title}}{{ app.name }} • Bid Resolution{{/title}}

    {{$content}}

        <h1>Bid Resolution</h1>

        {{#events | count}}
            <form method="get" action="/admin/bids.php">
                <label for="event-id-select">Select Race</label>
                <select
                    id="event-id-select"
                    name="event_id"
                    onchange="this.form.submit()"
                >
                    {{#events}}
                        <option
                            value="{{ event_id }}"
                            {{#selected}}selected{{/selected}}
                        >
                            {{ name }}
                        </option>
                    {{/events}}
                </select>
            </form>
        {{/events}}

        {{^events | count}}
            <p>No races have been added.</p>
        {{/events}}

        {{#event}}

            <div class="motogp-race-heading">
                <h2>{{ display_date }}</h2>
                <h2>{{> partials/race }}</h2>
            </div>

            {{#event.bids_open}}
                Bidding is still open. Bid winners shown below are provisional.
            {{/event.bids_open}}

            {{#resolved}}
                Bidding has been resolved.
            {{/resolved}}

            {{#waiting_for_earlier_event}}
                <article>
                    An earlier race must be settled before bidding for this race
                    can be resolved.
                </article>
            {{/waiting_for_earlier_event}}

            {{#can_resolve}}
                <form method="post" action="/admin/bids.php?event_id={{ event.event_id }}">
                    <input
                        type="hidden"
                        name="csrf_token"
                        value="{{ csrfToken }}"
                    >
                    <input
                        type="hidden"
                        name="action"
                        value="resolve"
                    >

                    <button type="submit">
                        resolve bidding
                    </button>
                </form>
            {{/can_resolve}}

            {{#riders}}
                <article>
                    <header>
                        <strong>{{> partials/rider }}</strong>
                    </header>

                    <table class="motogp-table">
                        <thead>
                            <tr>
                                <th>Player</th>
                                <th>Bid</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#bids}}
                                <tr>
                                    <td>{{ username }}</td>
                                    <td>{{ amount }}</td>
                                    <td>
                                        {{#winner}}
                                            <strong>winner</strong>
                                        {{/winner}}
                                    </td>
                                </tr>
                            {{/bids}}
                        </tbody>
                    </table>
                </article>
            {{/riders}}

            {{^riders}}
                <p>No bids have been placed for this race.</p>
            {{/riders}}

            {{#payout}}

                <h2>Payout{{^settled}} Preview{{/settled}}</h2>

                <p>
                    Prize pool:
                    <strong>{{ pool }}</strong>
                    points from
                    <strong>{{ winning_bids }}</strong>
                    winning bids.
                </p>

                <table class="motogp-table">
                    <thead>
                        <tr>
                            <th>Finish</th>
                            <th>Rider</th>
                            <th>Player</th>
                            <th>Share</th>
                            <th>Payout</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#payouts}}
                            <tr>
                                <td>{{ finish_position }}</td>
                                <td>{{> partials/rider }}</td>
                                <td>{{ username }}</td>
                                <td>{{ percentage }}%</td>
                                <td><strong>{{ payout }}</strong></td>
                            </tr>
                        {{/payouts}}
                    </tbody>
                </table>

                {{^payouts}}
                    <p>No classified winning riders are eligible for a payout.</p>
                {{/payouts}}

                {{#resolved}}
                    {{^results_complete}}
                        <article>
                            Results must be entered for all winning riders before
                            payouts can be settled.
                        </article>
                    {{/results_complete}}
                {{/resolved}}

                {{#can_settle}}
                    <form
                        id="settle-payouts-form"
                        method="post"
                        action="/admin/bids.php?event_id={{ event.event_id }}"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            value="{{ csrfToken }}"
                        >
                        <input
                            type="hidden"
                            name="action"
                            value="settle"
                        >

                        <button
                            type="button"
                            data-action="settle-payouts"
                        >
                            settle payouts
                        </button>
                    </form>
                {{/can_settle}}

                {{#settled}}
                    Payouts have been settled.
                {{/settled}}

            {{/payout}}

        {{/event}}

        {{> partials/modal-confirm }}

    {{/content}}

    {{$scripts}}
        <script src="/assets/js/bids.js"></script>
    {{/scripts}}

{{/partials/layout}}
