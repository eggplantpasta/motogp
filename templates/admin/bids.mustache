{{< partials/layout }}

{{$ title }}{{ app.name }} • Bid Resolution{{/ title }}

{{$ content }}

<h1>Bid Resolution</h1>

<form method="get" action="/admin/bids.php">
    <label for="event-id-select">Event</label>
    <select
        id="event-id-select"
        name="event_id"
        onchange="this.form.submit()"
    >
        {{#events}}
        <option
            value="{{event_id}}"
            {{#selected}}selected{{/selected}}
        >
            {{name}}
        </option>
        {{/events}}
    </select>
</form>

{{#event}}

<h2>{{name}}</h2>

<p>{{display_date}} · {{circuit}}</p>

{{#event.bids_open}}
<article>
    Bidding is still open. These results are provisional.
</article>
{{/event.bids_open}}

{{#resolved}}
<article>
    Bidding has been resolved.
</article>
{{/resolved}}

{{#can_resolve}}
<form method="post" action="/admin/bids.php?event_id={{event.event_id}}">
    <input
        type="hidden"
        name="csrf_token"
        value="{{csrfToken}}"
    >

    <button type="submit">
        Resolve Bidding
    </button>
</form>
{{/can_resolve}}

{{#riders}}
<article>
    <header>
        <strong>#{{ race_number }} {{ name }}</strong>
    </header>

    <table>
        <thead>
            <tr>
                <th>Player</th>
                <th>Bid</th>
                <th>Result</th>
            </tr>
        </thead>
        <tbody>
            {{#bids}}
            <tr>
                <td>{{ username }}</td>
                <td>{{ amount }}</td>
                <td>
                    {{#winner}}
                    <strong>Winner</strong>
                    {{/winner}}
                </td>
            </tr>
            {{/bids}}
        </tbody>
    </table>
</article>
{{/riders}}

{{^riders}}
<p>No bids have been placed for this event.</p>
{{/riders}}

{{/event}}

{{/ content }}

{{/ partials/layout }}
