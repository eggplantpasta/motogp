{{< partials/layout }}

{{$ title }}Manage Events{{/ title }}

{{$ content }}

<h1>Manage Events</h1>

<p>
    <a href="/admin/create-event.php" role="button">Create Event</a>
</p>

{{#message}}
<section role="alert" class="motogp-form-message {{message-class}}">
    {{message}}
</section>
{{/message}}

<table>
    <thead>
        <tr>
            <th>Date</th>
            <th>Event</th>
            <th>Circuit</th>
            <th>Country</th>
            <th>Bids Open</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        {{#events}}
        <tr>
            <td>{{display_date}}</td>
            <td>{{name}}</td>
            <td>{{circuit}}</td>
            <td>{{country_name}}</td>
            <td>{{#bids_open}}Yes{{/bids_open}}{{^bids_open}}No{{/bids_open}}</td>
            <td>
                <a href="/admin/edit-event.php?event_id={{event_id}}">
                    Edit
                </a>

                {{#can_delete}}
                <form
                    action="/admin/events.php"
                    method="post"
                    class="motogp-inline-form"
                    onsubmit="return confirm('Delete {{name}}?');"
                >
                    <input
                        type="hidden"
                        name="csrf_token"
                        value="{{csrfToken}}"
                    >
                    <input
                        type="hidden"
                        name="event_id"
                        value="{{event_id}}"
                    >
                    <button
                        type="submit"
                        class="motogp-link-button"
                    >
                        Delete
                    </button>
                </form>
                {{/can_delete}}
            </td>
        </tr>
        {{/events}}

        {{^events}}
        <tr>
            <td colspan="6">No events found.</td>
        </tr>
        {{/events}}
    </tbody>
</table>

{{/ content }}

{{/ partials/layout }}
