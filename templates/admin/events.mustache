{{< partials/layout}}

    {{$title}}{{ app.name }} • Manage Races{{/title}}

    {{$content}}

        <h1>Manage Races</h1>

        <p>
            <button
                type="button"
                class="motogp-icon-text-button"
                data-action="add-event"
                data-target="modal-edit"
            >
                {{> partials/icons/add }}
                add race
            </button>
        </p>

        <table class="motogp-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Race</th>
                    <th>Bidding</th>
                    <th>Admin</th>
                </tr>
            </thead>

            <tbody>
                {{#events}}
                    <tr
                        data-event-id="{{ event_id }}"
                        data-start-date="{{ start_date }}"
                        data-event-name="{{ name }}"
                        data-circuit="{{ circuit }}"
                        data-country-code="{{ country_code }}"
                        data-bids-open="{{ bids_open }}"
                    >
                        <td>{{ display_date }}</td>
                        <td>{{> partials/race }}</td>
                        <td>{{#bids_open}}open{{/bids_open}}</td>
                        <td>
                            <div class="motogp-button-group">
                                <button
                                    type="button"
                                    class="motogp-icon-button"
                                    data-action="edit-event"
                                    data-target="modal-edit"
                                    data-tooltip="Edit event"
                                    aria-label="Edit race"
                                >
                                    {{> partials/icons/edit }}
                                </button>

                                <button
                                    type="button"
                                    class="motogp-icon-button"
                                    data-action="delete-event"
                                    data-tooltip="{{#has_history}}Race has bidding or results history{{/has_history}}{{^has_history}}Delete race{{/has_history}}"
                                    aria-label="{{#has_history}}Cannot delete race with history{{/has_history}}{{^has_history}}Delete race{{/has_history}}"
                                    {{#has_history}}disabled{{/has_history}}
                                >
                                    {{> partials/icons/delete }}
                                </button>
                            </div>
                        </td>
                    </tr>
                {{/events}}
                {{^events}}
                    <tr>
                        <td colspan="4">No races have been added.</td>
                    </tr>
                {{/events}}
            </tbody>
        </table>

        <dialog
            id="modal-edit"
            {{#form.open_modal}}data-open-on-load="true"{{/form.open_modal}}
        >
            <article>
                <form id="event-form" method="post" novalidate>

                    <h2 id="event-form-heading">Edit race</h2>

                    <section
                        id="event-form-message"
                        role="alert"
                        class="motogp-form-message {{ form.message-class }}"
                    >
                        {{#form.message}}
                            {{ form.message }}
                        {{/form.message}}
                    </section>

                    <fieldset>
                        <input
                            type="hidden"
                            name="operation"
                            id="operation"
                            value="update"
                        >

                        <input
                            type="hidden"
                            name="event-id"
                            id="event-id"
                            value="{{ form.event_id }}"
                        >

                        <label>
                            Start date
                            <input
                                type="date"
                                name="start-date"
                                id="start-date"
                                value="{{ form.start_date }}"
                                aria-invalid="{{#form.errors.start_date}}true{{/form.errors.start_date}}"
                                aria-describedby="invalid-start_date"
                            >
                            <small id="invalid-start_date">
                                {{ form.errors.start_date }}
                            </small>
                        </label>

                        <label>
                            Race name
                            <input
                                type="text"
                                name="event-name"
                                id="event-name"
                                value="{{ form.name }}"
                                aria-invalid="{{#form.errors.name}}true{{/form.errors.name}}"
                                aria-describedby="invalid-name"
                            >
                            <small id="invalid-name">
                                {{ form.errors.name }}
                            </small>
                        </label>

                        <label>
                            Circuit
                            <input
                                type="text"
                                name="circuit"
                                id="circuit"
                                value="{{ form.circuit }}"
                            >
                        </label>

                        <label>
                            Country
                            <select
                                name="country-code"
                                id="country-code"
                            >
                                <option value="" disabled>Select country</option>

                                {{#countries}}
                                    <option
                                        value="{{ country_code }}"
                                        {{#selected}}selected{{/selected}}
                                    >
                                        {{ name }}
                                    </option>
                                {{/countries}}
                            </select>
                        </label>

                        <label>
                            <input
                                type="checkbox"
                                name="bids-open"
                                id="bids-open"
                                aria-invalid="{{#form.errors.bids_open}}true{{/form.errors.bids_open}}"
                                aria-describedby="invalid-bids_open"
                                {{#form.bids_open}}checked{{/form.bids_open}}
                            >
                            Bids open
                        </label>

                        <small id="invalid-bids_open" class="motogp-form-error">
                            {{ form.errors.bids_open }}
                        </small>
                    </fieldset>

                    <fieldset class="motogp-dialog-actions">
                        <button
                            type="button"
                            class="secondary"
                            data-action="close-modal"
                            data-target="modal-edit"
                        >
                            cancel
                        </button>

                        <button type="submit">
                            save
                        </button>
                    </fieldset>

                    <input
                        type="hidden"
                        name="csrf_token"
                        value="{{ csrfToken }}"
                    >
                </form>
            </article>
        </dialog>

        {{> partials/modal-confirm }}

    {{/content}}

    {{$scripts}}
        <script src="/assets/js/events.js"></script>
    {{/scripts}}

{{/partials/layout}}
