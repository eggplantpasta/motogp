{{< partials/layout}}

    {{$title}}{{ app.name }} • User Detail{{/title}}

    {{$content}}
        <h1>User Detail • {{ account.username }}</h1>

        <p>
            <a
                href="/statement.php?user_id={{ account.user_id }}"
                role="button"
                class="outline motogp-icon-text-button"
            >
                {{> partials/icons/statement }}
                statement
            </a>
        </p>

        <table class="motogp-table">
            <tbody>
                <tr>
                    <th scope="row">User ID</th>
                    <td>{{ account.user_id }}</td>
                    <td></td>
                </tr>

                <tr>
                    <th scope="row">Username</th>
                    <td>{{ account.username }}</td>
                    <td></td>
                </tr>

                <tr>
                    <th scope="row">Email</th>
                    <td>{{ account.email }}</td>
                    <td></td>
                </tr>

                <tr>
                    <th scope="row">Balance</th>
                    <td>
                        {{ account.balance }}
                    </td>
                    <td>
                        <form
                            method="post"
                            action="/admin/user.php?user_id={{ account.user_id }}"
                            class="motogp-inline-form"
                        >
                            <input
                                type="hidden"
                                name="csrf_token"
                                value="{{ csrfToken }}"
                            >
                            <input
                                type="hidden"
                                name="action"
                                value="update_balance"
                            >

                            <fieldset role="group" class="motogp-compact-group">
                                <input
                                    type="number"
                                    name="balance"
                                    value="{{ account.balance }}"
                                    min="0"
                                    step="1"
                                    required
                                >
                                <button type="submit">update</button>
                            </fieldset>
                        </form>
                    </td>
                </tr>

                <tr>
                    <th scope="row">Administrator</th>
                    <td>
                        {{#account.admin}}
                            <span class="motogp-icon" aria-label="Yes">
                                {{> partials/icons/yes }}
                            </span>
                        {{/account.admin}}
                    </td>
                    <td>
                        <form
                            method="post"
                            action="/admin/user.php?user_id={{ account.user_id }}"
                            class="motogp-inline-form"
                        >
                            <input
                                type="hidden"
                                name="csrf_token"
                                value="{{ csrfToken }}"
                            >
                            <input
                                type="hidden"
                                name="action"
                                value="set_admin"
                            >

                            {{#account.canSetAdmin}}
                                <input
                                    type="checkbox"
                                    role="switch"
                                    name="admin"
                                    value="1"
                                    {{#account.admin}}checked{{/account.admin}}
                                    onchange="this.form.submit()"
                                    aria-label="Administrator"
                                >
                            {{/account.canSetAdmin}}

                            {{^account.canSetAdmin}}
                                <input
                                    type="checkbox"
                                    role="switch"
                                    {{#account.admin}}checked{{/account.admin}}
                                    disabled
                                    aria-label="Administrator"
                                >
                            {{/account.canSetAdmin}}
                        </form>
                    </td>
                </tr>

                <tr>
                    <th scope="row">Status</th>
                    <td>
                        {{#account.canApprove}}
                            Pending approval
                        {{/account.canApprove}}

                        {{#account.canDisable}}
                            Active
                        {{/account.canDisable}}

                        {{#account.canEnable}}
                            Disabled
                        {{/account.canEnable}}
                    </td>

                    <td>
                        {{#account.canApprove}}
                            <form
                                method="post"
                                action="/admin/user.php?user_id={{ account.user_id }}"
                                class="motogp-inline-form"
                            >
                                <input
                                    type="hidden"
                                    name="csrf_token"
                                    value="{{ csrfToken }}"
                                >
                                <input type="hidden" name="action" value="approve">

                                <button type="submit">approve</button>
                            </form>
                        {{/account.canApprove}}

                        {{#account.isActive}}
                            <form
                                method="post"
                                action="/admin/user.php?user_id={{ account.user_id }}"
                                class="motogp-inline-form"
                            >
                                <input
                                    type="hidden"
                                    name="csrf_token"
                                    value="{{ csrfToken }}"
                                >
                                <input type="hidden" name="action" value="disable">

                                <button
                                    type="submit"
                                    {{^account.canDisable}}disabled{{/account.canDisable}}
                                >
                                    disable
                                </button>
                            </form>
                        {{/account.isActive}}

                        {{#account.canEnable}}
                            <form
                                method="post"
                                action="/admin/user.php?user_id={{ account.user_id }}"
                                class="motogp-inline-form"
                            >
                                <input
                                    type="hidden"
                                    name="csrf_token"
                                    value="{{ csrfToken }}"
                                >
                                <input type="hidden" name="action" value="enable">

                                <button type="submit">enable</button>
                            </form>
                        {{/account.canEnable}}
                    </td>
                </tr>

                <tr>
                    <th scope="row">
                        Registered<br>
                        Approved<br>
                        Disabled
                    </th>
                    <td>
                        {{ account.created_at }}<br>
                        {{#account.approved_at}}{{ account.approved_at }}{{/account.approved_at}}
                        {{^account.approved_at}}—{{/account.approved_at}}
                        <br>
                        {{#account.disabled_at}}{{ account.disabled_at }}{{/account.disabled_at}}
                        {{^account.disabled_at}}—{{/account.disabled_at}}
                    </td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    {{/content}}

{{/partials/layout}}
