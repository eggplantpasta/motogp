{{< partials/layout}}

    {{$title}}{{ app.name }} • Admin{{/title}}

    {{$content}}

        <div class="grid">
            <section>
                <h1>Admin</h1>
                <ul>
                    <li><a href="/admin/users.php">Users</a> Manage user registrations, approvals, access and balances.</li>
                </ul>
                <hr>
                <ul>
                    <li><a href="/admin/teams.php">Teams</a> Manage teams.</li>
                    <li><a href="/admin/riders.php">Riders</a> Manage riders.</li>
                    <li><a href="/admin/events.php">Races</a> Manage MotoGP events.</li>
                    <li><a href="/admin/bids.php">Bids</a> Manage player bids.</li>
                    <li><a href="/admin/results.php">Results</a> Manage race results.</li>
                </ul>
            </section>
            <section>
                <h1>Tasks</h1>

                {{#hasPendingUsers}}
                    <article>
                        <header>Users</header>

                        <p>
                            {{ pendingUserCount }}
                            registrations awaiting approval.
                        </p>

                        <a
                            href="/admin/users.php"
                            role="button"
                            class="outline motogp-icon-text-button"
                        >
                            manage users
                        </a>
                    </article>
                {{/hasPendingUsers}}

                {{#hasStalePendingUsers}}
                    <article>
                        <header>Stale registrations</header>

                        <p>
                            {{ stalePendingUserCount }}
                            unapproved registrations are older than
                            {{ pendingUserExpiryDays }} days.
                        </p>

                        <form
                            method="post"
                            action="/admin/"
                            class="stale-user-delete-form motogp-inline-form"
                            data-count="{{ stalePendingUserCount }}"
                            data-expiry-days="{{ pendingUserExpiryDays }}"
                        >
                            <input
                                type="hidden"
                                name="csrf_token"
                                value="{{ csrfToken }}"
                            >
                            <input
                                type="hidden"
                                name="action"
                                value="delete_expired_pending_users"
                            >

                            <button
                                type="button"
                                data-action="delete-stale-users"
                            >
                                delete stale registrations
                            </button>
                        </form>
                    </article>
                {{/hasStalePendingUsers}}

                {{#noOpenBidding}}
                    <article>
                        <header>Bidding</header>

                        <p>No race is currently open for bidding.</p>

                        <a
                            href="/admin/events.php"
                            role="button"
                            class="outline motogp-icon-text-button"
                        >
                            manage races
                        </a>
                    </article>
                {{/noOpenBidding}}

                {{#hasEventReadyToResolveBids}}
                    <article>
                        <header>Resolve bidding</header>

                        <p>
                            {{ eventReadyToResolveBids.name }}
                            has closed bidding and is ready to resolve.
                        </p>

                        <a
                            href="/admin/bids.php?event_id={{ eventReadyToResolveBids.event_id }}"
                            role="button"
                            class="outline motogp-icon-text-button"
                        >
                            manage bids
                        </a>
                    </article>
                {{/hasEventReadyToResolveBids}}

                {{#hasEventAwaitingResults}}
                    <article>
                        <header>Race results</header>

                        <p>
                            Results are still required for
                            {{ eventAwaitingResults.name }}
                            before payouts can be settled.
                        </p>

                        <a
                            href="/admin/results.php?event_id={{ eventAwaitingResults.event_id }}"
                            role="button"
                            class="outline motogp-icon-text-button"
                        >
                            enter results
                        </a>
                    </article>
                {{/hasEventAwaitingResults}}

                {{#hasEventReadyToSettlePayouts}}
                    <article>
                        <header>Settle payouts</header>

                        <p>
                            {{ eventReadyToSettlePayouts.name }}
                            has complete results and is ready for payout settlement.
                        </p>

                        <a
                            href="/admin/bids.php?event_id={{ eventReadyToSettlePayouts.event_id }}"
                            role="button"
                            class="outline motogp-icon-text-button"
                        >
                            settle payouts
                        </a>
                    </article>
                {{/hasEventReadyToSettlePayouts}}

                {{^hasAdminTasks}}
                    <p>No admin tasks currently require attention.</p>
                {{/hasAdminTasks}}
            </section>
        </div>

        {{> partials/modal-confirm }}

        {{$scripts}}
            <script src="/assets/js/admin.js"></script>
        {{/scripts}}

    {{/content}}

{{/partials/layout}}
