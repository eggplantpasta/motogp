{{< partials/layout}}

    {{$title}}{{ app.name }} • Bids{{/title}}

    {{$content}}

        <h1>Place Bids <span class="motogp-icon">{{> partials/icons/bid }}</span></h1>

        {{#event}}
            <div class="motogp-race-heading">
                <p>{{ event.display_date }}</p>
                <p>{{> partials/race }}</p>
            </div>
        {{/event}}

        <p>
            Available points: <strong>{{ user.balance }}</strong>
        </p>

        {{#message}}
            <p>{{ message }}</p>
        {{/message}}

        {{#has_errors}}
            <article>
                <strong>Please check your bids:</strong>
                <ul>
                    {{#errors}}
                        <li>{{ . }}</li>
                    {{/errors}}
                </ul>
            </article>
        {{/has_errors}}

        <form method="post">

            <table class="motogp-table">
                <thead>
                    <tr>
                        <th>Rider</th>
                        <th>Points</th>
                    </tr>
                </thead>

                <tbody>
                    {{#bid_rows}}
                        <tr>
                            <td>
                                <select name="rider-{{ bid_number }}">
                                    <option value="">select</option>

                                    {{#riders}}
                                        <option
                                            value="{{ rider_id }}"
                                            {{#selected}}selected{{/selected}}
                                        >
                                            {{ name }} {{ race_number }}
                                        </option>
                                    {{/riders}}
                                </select>
                            </td>

                            <td>
                                <input
                                    type="number"
                                    name="amount-{{ bid_number }}"
                                    value="{{ amount }}"
                                    min="0"
                                    step="1"
                                >
                            </td>
                        </tr>
                    {{/bid_rows}}
                </tbody>
            </table>

            <input
                type="hidden"
                name="csrf_token"
                value="{{ csrfToken }}"
            >

            <button type="submit">save bids</button>

        </form>

    {{/content}}

{{/partials/layout}}
